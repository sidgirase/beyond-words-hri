<mujoco model="stretch custom scene">
  <!-- Include the menagerie model -->
  <include file="stretch.xml"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <global azimuth="160" elevation="-20" offwidth="640" offheight="480"/>
  </visual>

  <asset>
    <material name="floor" rgba=".1 .1 .1 1" reflectance="0.1"/>
    <material name="wood" rgba="0.6 0.4 0.2 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="2 2 0.05" type="plane" material="floor"/>
    
    <!-- Table in front of the robot -->
    <body name="table" pos="0.7 0 0.24">
      <geom type="box" size=".3 .5 .24" mass="1" material="wood"/>
      
      <!-- Red Cup (Left) -->
      <body name="red_cup" pos="0 -0.2 0.3">
        <freejoint/>
        <!-- Cup body (cylinder) -->
        <geom type="cylinder" size="0.04 0.06" rgba="1 0.1 0.1 1" mass="0.1"/>
      </body>
      
      <!-- Blue Cup (Right) -->
      <body name="blue_cup" pos="0 0.2 0.3">
        <freejoint/>
        <geom type="cylinder" size="0.04 0.06" rgba="0.1 0.1 1 1" mass="0.1"/>
      </body>
    </body>
  </worldbody>
</mujoco>
